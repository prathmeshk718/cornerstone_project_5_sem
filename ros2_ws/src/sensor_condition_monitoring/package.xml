<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_condition_monitoring</name>
  <version>1.0.0</version>
  <description>
    ROS 2 Humble package for Arduino Uno multi-sensor acquisition (DS18B20, DHT11, Flame Sensor),
    predictive condition monitoring, SQLite persistence, and WebSocket streaming to React dashboard.
  </description>
  <maintainer email="maintainer@example.com">Condition Monitoring Lab</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
